# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# The origin the React app is served from (used for CORS and CSRF origin checks)
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_manager
DB_USER=postgres
DB_PASSWORD=change-me

# Long random string used to sign session cookies (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Idle session lifetime in minutes (the session is extended on activity)
SESSION_MAX_AGE_MINUTES=120

# Failed login attempts allowed per IP address per 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# Set to 1 when running behind a reverse proxy (needed for Secure cookies over HTTPS)
TRUST_PROXY=0

# Optional: first administrator for `npm run create-admin`.
# Leave blank to be prompted interactively instead (recommended: the password is not stored on disk).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database used only by `npm test`. Its name MUST end in _test; the tests erase all data in it.
TEST_DB_NAME=expense_manager_test
